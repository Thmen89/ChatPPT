# syntax=docker/dockerfile:1.7
#
# Development container: the repository is mounted at /app and both servers reload on
# change. Unlike the product image, it installs dependencies into the mounted tree when it
# starts (that is the point of a dev container); start.js itself installs nothing.
#
#   docker compose -f deploy/compose.dev.yml up

ARG PYTHON_IMAGE=python:3.11-slim-trixie
ARG NODE_IMAGE=node:22-trixie-slim
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.11.32

FROM ${UV_IMAGE} AS uv
FROM ${NODE_IMAGE} AS node

FROM ${PYTHON_IMAGE}
COPY --from=uv /uv /usr/local/bin/uv
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates unzip chromium fonts-liberation fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    CHATPPT_PYTHON=/opt/venv/bin/python \
    CHATPPT_FASTEMBED_ICON_CACHE_DIR=/opt/chatppt/fastembed-icons \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    NEXT_TELEMETRY_DISABLED=1 \
    CYPRESS_INSTALL_BINARY=0 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

WORKDIR /app
EXPOSE 5000
CMD ["sh", "-c", "uv sync --project servers/fastapi --frozen \
  && (cd servers/fastapi && /opt/venv/bin/python scripts/warm_fastembed_cache.py) \
  && npm --prefix servers/nextjs ci --no-audit --no-fund \
  && node scripts/sync-presentation-export.cjs \
  && exec node start.js --dev"]
