# Only what the Dockerfile copies matters; keep the build context small and the cache stable.
.git
.github
.gitignore
.claude
docs
deploy
*.md
!servers/fastapi/prompts/**/*.md
bench-results.json

node_modules
**/node_modules
**/.next
**/.next-build
**/.venv
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/__pycache__
**/*.pyc
**/debug
**/fastembed_cache
**/chroma
.cache
app_data
data
chatppt
presentation-export
scripts/bench
servers/fastapi/tests
servers/fastapi/chatppt_backend.egg-info
servers/fastapi/.python-version
servers/fastapi/placeholder
servers/fastapi/tmp
servers/nextjs/e2e
servers/nextjs/playwright.config.ts
servers/nextjs/cypress
servers/nextjs/cypress.config.ts
servers/nextjs/tsconfig.tsbuildinfo
**/*.cy.ts
**/*.cy.tsx

# Keep only the LiteParse runner from the Electron tree.
electron/*
!electron/resources
electron/resources/*
!electron/resources/document-extraction
electron/resources/document-extraction/*
!electron/resources/document-extraction/liteparse_runner.mjs

container.db
